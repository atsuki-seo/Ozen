recipe yakisoba(servings: 2) @vessel(FlatPlate) {
  ingredients {
    noodles: SteamedNoodles 1 pcs per serving
    pork: Komagire 50 g per serving
    cabbage: 75 g per serving
    sprouts: BeanSprouts 50 g per serving
    sauce: WorcesterSauce 1.5 tbsp per serving
  }
  let cabbageCut = cabbage |> cut(roughChop, 30 mm)
  let loosened = noodles |> loosen
  let porkFried = pork |> fry(3 min, heat: high)
  let vegetables = fry([porkFried, cabbageCut, sprouts], 2 min, heat: high)
  let seasoned = [vegetables, loosened] |> fry(2 min, heat: high) |> season(sauce)
}
