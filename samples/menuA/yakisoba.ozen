recipe yakisoba(servings: 2) @vessel(FlatPlate) {
  ingredients {
    noodles: SteamedNoodles 2 pcs
    pork: Komagire 100 g
    cabbage: 150 g
    sprouts: BeanSprouts 100 g
    sauce: WorcesterSauce 3 tbsp
  }
  let cabbageCut = cut(cabbage, roughChop, 30 mm)
  let loosened = loosen(noodles)
  let porkFried = fry(pork, 3 min, heat: high)
  let vegetables = fry([porkFried, cabbageCut, sprouts], 2 min, heat: high)
  let mixed = fry([vegetables, loosened], 2 min, heat: high)
  let seasoned = season(mixed, sauce)
}
