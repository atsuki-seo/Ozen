recipe karubiTopping(meat: Beef<Fatty>, servings: 2) {
  ingredients {
    onion: 0.5 pcs per serving
    sauce: WorcesterSauce 1 tbsp per serving
    sugar: Sugar 0.5 tsp per serving
  }
  let onionCut = onion |> peel |> cut(slice, 5 mm)
  let topping = [meat, onionCut] |> fry(5 min, heat: high) |> season(sauce)
}
