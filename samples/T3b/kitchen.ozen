kitchen withDishwasher {
  places {
    stove: IHStove { burners: 2 }
    dishwasher: Dishwasher
  }
  tools {
    board: CuttingBoard
    knife: Knife
    pan: FryingPan
    bowl: MixingBowl
    pot: Pot { count: 2 }
    cooker: RiceCooker
    ladle: Ladle
  }
  tableware {
    plate: FlatPlate { count: 4 }
    deep: DeepPlate { count: 4 }
    soupBowl: SoupBowl { count: 4 }
    riceBowl: RiceBowl { count: 4 }
  }
}
