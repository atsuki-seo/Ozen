recipe curry(servings: 4) {
  ingredients {
    onion: 0.5 pcs per serving
    roux: CurryRoux 25 g per serving
    water: 200 ml per serving
  }
  let sliced = onion |> peel |> cut(slice, 3 mm)
  let fried = fry(sliced, 10 min, heat: medium)
  let simmered = simmer([fried, water, roux], 20 min)
}
