recipe araNi(ara: Buri<frame>, servings: 4) {
  ingredients {
    water: 100 ml per serving
    sugar: Sugar 0.5 tbsp per serving
    miso: Miso 0.5 tbsp per serving
  }
  let simmered = simmer([ara, water, sugar], 20 min)
  let seasoned = dissolve([simmered, miso])
}
