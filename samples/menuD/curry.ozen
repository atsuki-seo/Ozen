recipe curry(servings: 4) {
  ingredients {
    pork: Komagire 50 g per serving
    onion: 0.5 pcs per serving
    carrot: 0.25 pcs per serving
    roux: CurryRoux 25 g per serving
    water: 200 ml per serving
  }
  let onionCut = onion |> peel |> cut(slice, 3 mm)
  let carrotCut = carrot |> peel |> cut(rollCut, 20 mm)
  let fried = fry([pork, onionCut, carrotCut], 5 min)
  let simmered = simmer([fried, water], 15 min)
  let curry = dissolve([simmered, roux])
}
