kitchen home {
  places {
    stove: IHStove { burners: 2 }
    fridge: Fridge
    freezer: Freezer
  }
  tools {
    board: CuttingBoard
    knife: Knife
    peeler: Peeler
    pan: FryingPan
    bowl: MixingBowl { count: 2 }
    pot: Pot { count: 2 }
    cooker: RiceCooker
    ladle: Ladle
    whisk: Whisk
  }
  tableware {
    deep: DeepPlate { count: 4 }
    small: SmallBowl { count: 4 }
    glass: Glass { count: 4 }
  }
}
