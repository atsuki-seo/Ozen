recipe stirFry(servings: 4) {
  ingredients {
    pork: Pork<belly> 50 g per serving
    cabbage: 75 g per serving
    salt: Salt 1 pinch
    pepper: Pepper 1 dash
  }
  let porkCut = cut(pork, biteSize, 30 mm)
  let marinated = porkCut |> season(salt) |> rest(10 min)
  let porkFried = fry(marinated, 3 min, heat: high)
  let cabbageCut = cut(cabbage, roughChop, 30 mm)
  let fried = fry([porkFried, cabbageCut], 3 min, heat: high)
  let seasoned = season(fried, pepper)
}
