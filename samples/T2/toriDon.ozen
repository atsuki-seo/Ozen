recipe toriDon(servings: 1) {
  ingredients {
    chicken: Chicken<thigh> 100 g
    onion: 1/2 pcs
    water: 70 ml
    dashi: Dashi 1/2 tsp
    sugar: Sugar 1 tsp
  }
  let chickenCut = cut(chicken, biteSize, 30 mm)
  let onionCut = cut(peel(onion), slice, 5 mm)
  let sauce = mix([water, dashi, sugar])
  let topping = simmer([chickenCut, onionCut, sauce], 10 min)
}
