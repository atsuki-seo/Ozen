recipe oyakodon(servings: 3) {
  ingredients {
    chicken: Chicken<thigh> 100 g per serving
    onion: 1/3 pcs per serving
    egg: 1 pcs per serving
    water: 200 ml
    dashi: Dashi 1 tsp
    sugar: Sugar 1 tbsp
  }
  let chickenCut = cut(chicken, biteSize, 30 mm)
  let onionCut = onion |> peel |> cut(slice, 5 mm)
  let simmered = simmer([chickenCut, onionCut, water, dashi, sugar], 10 min)
  let beaten = egg |> mix
  let topping = simmer([simmered, beaten], 2 min)
}
