recipe mixJuice(servings: 4) {
  ingredients {
    banana1: Banana 0.25 pcs per serving
    strawberry1: Strawberry 25 g per serving
    milk1: Milk 75 ml per serving
    banana2: Banana 0.25 pcs per serving
    strawberry2: Strawberry 25 g per serving
    milk2: Milk 75 ml per serving
  }
  let first = blend([banana1 |> peel, strawberry1, milk1])
  let second = blend([banana2 |> peel, strawberry2, milk2])
  let juice = combine([first, second])
}
