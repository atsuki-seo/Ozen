recipe porkSoup {
  ingredients {
    pork: 200 g
    onion: 1 pcs
  }
  let stock = pork |> simmer(10 min)
  let onionCut = onion |> peel |> cut(slice, 5 mm)
  let soup = simmer([stock, onionCut], 5 min)
}

recipe goldenPork {
  ingredients { pork: 200 g }
  let fried = pork |> fry(3 min)
  let browned = fried |> fry(2 min, until: browning >= golden)
}

recipe newPot {
  ingredients {
    pork: 200 g
    onion: 1 pcs
  }
  let stock = pork |> simmer(10 min)
  let onionCut = onion |> peel |> cut(slice, 5 mm)
  let soup = simmer([stock, onionCut], 5 min) @newVessel
}
