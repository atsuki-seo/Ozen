recipe cookedRice(withOnion: Count = 1) {
  ingredients {
    rice: 300 g
    onion: 1 pcs
  }
  let peeled = peel(onion)
  let soaked = rice |> wash |> soak(30 min)
  if withOnion > 0 {
    let mixed = mix([soaked, peeled])
  } else {
    let rested = rest(soaked, 5 min)
  }
}
menu dinner(people: 2) {
  let rice = make cookedRice(withOnion: 0)
  serve main {
    plate perPerson on RiceBowl { rice }
  }
}
