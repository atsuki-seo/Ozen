// args: debug schedule --kitchen home --options today
action trim(x: T) -> T {
  uses hands, CuttingSurface for 4 min
  leaves: x on CuttingSurface
}
action sear(x: T) -> T<doneness: done> {
  uses hands, HeatSource<stovetop>, FryingPan for 3 min
  leaves: oil on FryingPan
}
action stew(x: T) -> T<doneness: done> {
  uses HeatSource<stovetop>, Pot for 20 min @unattended
}
action fold(x: T) -> T {
  uses hands for 4 min
}
recipe r() {
  ingredients {
    lettuce: Lettuce 100 g
    cabbage: Cabbage 100 g
    tofu: Tofu 100 g
    carrot: Carrot 1 pcs
  }
  let lettuce0 = fold(lettuce)
  let lettuce1 = trim(lettuce0)
  let cabbage0 = trim(cabbage)
  let cabbage1 = fold(cabbage0)
  let tofu0 = sear(tofu)
  let carrot0 = trim(carrot)
  let carrot1 = stew(carrot0)
}
kitchen home {
  places {
    floor: Floor { capacity: 2 }
    stove: IHStove { burners: 1 }
  }
  tools {
    board: CuttingBoard { count: 2 }
    pan: FryingPan { count: 2 }
    pot: Pot { count: 1 }
  }
}
kitchen today : Options {
  cooks: 2
  prefer: [fewerWashes]
}
