// args: debug schedule --kitchen home --options today
action trim(x: T) -> T {
  uses hands, CuttingSurface for 4 min
  leaves: x on CuttingSurface
}
action sear(x: T) -> T<doneness: done> {
  uses hands, HeatSource<stovetop>, FryingPan for 5 min
  leaves: oil on FryingPan
}
action stew(x: T) -> T<doneness: done> {
  uses HeatSource<stovetop>, Pot for 10 min @unattended
}
action fold(x: T) -> T {
  uses hands for 2 min
}
recipe r() {
  ingredients {
    carrot: Carrot 1 pcs
    pork: Pork 200 g
    onion: Onion 1 pcs
    cabbage: Cabbage 100 g
  }
  let carrot0 = trim(carrot)
  let carrot1 = fold(carrot0)
  let pork0 = sear(pork)
  let onion0 = stew(onion)
  let onion1 = fold(onion0)
  let cabbage0 = fold(cabbage)
  let cabbage1 = trim(cabbage0)
}
kitchen home {
  places {
    floor: Floor { capacity: 2 }
    stove: IHStove { burners: 2 }
  }
  tools {
    board: CuttingBoard { count: 2 }
    pan: FryingPan { count: 1 }
    pot: Pot { count: 2 }
  }
}
kitchen today : Options {
  cooks: 2
  prefer: [lessWaiting]
}
