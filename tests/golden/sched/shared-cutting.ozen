// args: debug schedule --entry dinner --options today
action slice2(x: T) -> T {
  uses hands, CuttingSurface for 2 min
}
recipe ramen {
  ingredients {
    negi: Cabbage 50 g
  }
  let sliced = slice2(negi)
}
recipe friedRice {
  ingredients {
    negi: Cabbage 50 g
  }
  let sliced = slice2(negi)
}
menu dinner {
  let ramenBowl = make ramen
  let friedRicePlate = make friedRice
}
kitchen today : Options {
  cooks: 1
}
