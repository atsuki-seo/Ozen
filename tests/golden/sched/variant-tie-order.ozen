// args: debug schedule --kitchen home --options today
action steam(x: T) -> T<doneness: done> {
  variant basket {
    uses HeatSource<stovetop>, Pot for 10 min @unattended
  }
  variant micro {
    uses HeatSource<microwave> for 10 min @unattended
  }
}
kitchen home {
  places {
    stove: IHStove
    micro: Microwave
  }
  tools {
    pot: Pot
  }
}
recipe r() {
  ingredients { potato: 1 pcs }
  let s = steam(potato)
}
kitchen today : Options {
  cooks: 1
}
