// args: debug ir
action stew(x: T) -> T<doneness: done> {
  uses HeatSource<stovetop>, Pot @unattended
  takes heating(x, simmer, 2)
}
action stewWide(x: T) -> T<doneness: done> {
  uses HeatSource<stovetop>, Pot @unattended
  takes heating(x, simmer, 1..2)
}
recipe r() {
  ingredients {
    a: Carrot 1 pcs
    b: Carrot 1 pcs
    c: Carrot 1 pcs
  }
  let x = stew(cut(a, style: dice, size: 20 mm))
  let y = stew(cut(b, style: dice, size: 40 mm))
  let z = stewWide(cut(c, style: dice, size: 40 mm))
}
