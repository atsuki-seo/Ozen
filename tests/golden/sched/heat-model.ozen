// args: debug ir
action stew(smallStew: T) -> T<doneness: done> {
  uses HeatSource<stovetop>, Pot @unattended
  takes heating(smallStew, simmer, 2)
}
action stewWide(smallStew: T) -> T<doneness: done> {
  uses HeatSource<stovetop>, Pot @unattended
  takes heating(smallStew, simmer, 1..2)
}
recipe stewTrial {
  ingredients {
    a: Carrot 1 pcs
    b: Carrot 1 pcs
    c: Carrot 1 pcs
  }
  let smallStew = stew(cut(a, style: dice, size: 20 mm))
  let largeStew = stew(cut(b, style: dice, size: 40 mm))
  let wideStew = stewWide(cut(c, style: dice, size: 40 mm))
}
