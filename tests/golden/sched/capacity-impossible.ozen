// args: debug schedule --kitchen home
action twoPots(x: T) -> T<doneness: done> {
  uses HeatSource<stovetop>, Pot, Pot for 10 min @unattended
}
kitchen home {
  places {
    stove: IHStove
  }
  tools {
    pot: Pot
  }
}
recipe boiledPotato {
  ingredients { potato: 1 pcs }
  let boiled = twoPots(potato)
}
