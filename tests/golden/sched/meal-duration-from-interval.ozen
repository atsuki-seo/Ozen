// args: debug schedule --entry dinner --options today
action chopA(x: T) -> T {
  uses hands for 2 min
}
action whipC(x: T) -> T {
  uses hands for 3 min
}
recipe salad {
  ingredients {
    lettuce: 100 g
  }
  let chopped = chopA(lettuce)
}
recipe sweet {
  ingredients {
    ice: VanillaIce 100 g
  }
  let rested = rest(ice, 5 min)
  let whipped = whipC(rested)
}
menu dinner {
  let saladPlate = make salad
  let sweetPlate = make sweet
  serve main {
    plate perPerson on FlatPlate { saladPlate }
  }
  serve sweets after main + 20 min {
    plate perPerson on Glass { sweetPlate }
  }
}
kitchen today : Options {
  cooks: 1
}
