// args: debug schedule --entry dinner --options today
action h1(x: T) -> T<doneness: done> {
  uses hands for 2 min
}
action h2(x: T) -> T<doneness: done> {
  uses hands for 5 min
}
recipe a() {
  ingredients {
    pork: 200 g
  }
  let s0 = h1(pork)
}
recipe b() {
  ingredients {
    dashi: 300 ml
  }
  let s0 = rest(dashi, 10 min)
  let s1 = h1(s0)
}
recipe c() {
  ingredients {
    lettuce: 100 g
  }
  let s0 = rest(lettuce, 30 min)
  let s1 = h1(s0)
}
menu dinner() {
  let a1 = make a()
  let b1 = make b()
  let c1 = make c()
  serve main {
    plate perPerson on DeepPlate { a1 } @serveWithin(1 min)
    plate perPerson on DeepPlate { b1 } @serveWithin(1 min)
    plate perPerson on DeepPlate { c1 }
  }
}
kitchen today : Options {
  cooks: 2
}
