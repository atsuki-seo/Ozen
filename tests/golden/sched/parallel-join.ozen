// args: debug schedule --options today
recipe teishoku {
  ingredients {
    rice: 300 g
    onion: 1 pcs
    carrot: 1 pcs
  }
  parallel {
    branch a {
      let washed = wash(rice)
    }
    branch b {
      let peeled = peel(onion)
    }
  }
  let combined = peel(carrot)
}
kitchen today : Options {
  cooks: 2
}
