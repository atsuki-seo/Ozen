// args: debug schedule --options today
recipe teishoku {
  ingredients {
    rice: 300 g
    carrot: 2 pcs
  }
  let (portion, rest) = split(rice, 200 g)
  store(rest)
  let washed = wash(portion)
  let (carrotPortion, carrotRest) = split(carrot, 1 pcs)
  discard(carrotRest)
}
kitchen today : Options {
  cooks: 1
}
