// args: debug ir
action stew(sliceStew: T) -> T<doneness: done> {
  uses HeatSource<stovetop>, Pot @unattended
  takes heating(sliceStew, simmer, 2)
}
recipe stewTrial {
  ingredients {
    a: Carrot 1 pcs
    b: Carrot 1 pcs
    c: Carrot 1 pcs
  }
  let sliceStew = stew(cut(a, style: slice, size: 10 mm))
  let diceStew = stew(cut(b, style: dice, size: 10 mm))
  let chunkStew = stew(cut(c, style: roughChop, size: 10 mm))
}
