ir r
  %1 = in onion : Onion 1 pcs
  %2 = op peel %1 : Onion -> Onion<shape: peeled> 1 pcs [hands, WorkSurface; 60..120 s]
  %3 = op cut %2 style=dice size=3 mm : Onion<shape: peeled> -> Onion<shape: cut(dice, 3 mm)> 1 pcs [hands, WorkSurface, CuttingSurface, Knife; 60..180 s]
  %4 = in rice : Rice 300 g
  %5 = op soak %4 time=1800 s : Rice -> Rice<prep has soaked(1800 s)> 300 g [Container; 1800 s; unattended]
  %6 = op fry %3 time=300 s heat=medium : Onion<shape: cut(dice, 3 mm)> -> Onion<doneness: done, browning: light, shape: cut(dice, 3 mm)> 1 pcs [hands, HeatSource<stovetop>, FryingPan; 300 s]
result ok errors=0 warnings=0 infos=0
exit 0
