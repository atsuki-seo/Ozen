// args: debug ir
recipe salad {
  ingredients { lettuce: 100 g }
  let torn = tear(lettuce)
}
recipe dessert {
  ingredients { ice: VanillaIce 100 g }
  let served = layer(ice)
}
menu dinner {
  let served = make salad
  let dessertPlate = make dessert
  serve main {
    plate perPerson on FlatPlate { served }
  }
  serve sweets after main + 40 min {
    plate perPerson on Glass { dessertPlate }
  }
}
