// args: debug ir --kitchen home
kitchen home {
  places {
    stove: IHStove
  }
  tools {
    pan: FryingPan { capacity: 250 g }
  }
}
recipe porkGinger {
  ingredients { pork: 500 g }
  let batches = ceil(pork / kitchen.pan.capacity)
  repeat batches {
    let fried = fry(pork / batches, 8 min)
  }
}
