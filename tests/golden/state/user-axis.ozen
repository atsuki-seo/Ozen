axis firmness : ordered { soft, firm }
ingredient Kinugoshi : Vegetable {
  axes: firmness
}
action press(x: T) -> T<firmness: firm>
action slab(x: T<firmness >= firm>) -> T
recipe hiyayakko {
  ingredients {
    softTofu: Kinugoshi 1 pcs
    pressedTofu: Kinugoshi 1 pcs
  }
  let bad = slab(softTofu)
  let good = slab(press(pressedTofu))
}
