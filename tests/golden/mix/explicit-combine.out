ir juice
  %1 = in milk1 : Milk 300 ml
  %2 = op blend %1 : Milk -> Milk 300 ml [Blending; 30..90 s]
  %3 = in milk2 : Milk 300 ml
  %4 = op blend %3 : Milk -> Milk 300 ml [Blending; 30..90 s]
  %5 = op combine %2, %4 : Milk, Milk -> Mixture 616.8..624 g with Allergen(milk) [0 s]
  %6 = op blend %5 : Mixture -> Mixture 616.8..624 g with Allergen(milk) [Blending; 30..90 s]
result ok errors=0 warnings=0 infos=0
exit 0
