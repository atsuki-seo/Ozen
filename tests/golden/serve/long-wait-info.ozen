// args: debug schedule --entry dinner --options today
action stewY(x: T) -> T<doneness: done> {
  uses hands for 40 min
}
recipe xdish() {
  ingredients {
    dashi: 300 ml
  }
  let r = rest(dashi, 10 min)
}
recipe ydish() {
  ingredients {
    pork: 300 g
  }
  let s = stewY(pork)
}
recipe zdish() {
  ingredients {
    water: 300 ml
  }
  let r = rest(water, 13 min)
}
menu dinner() {
  let x = make xdish()
  let y = make ydish()
  let z = make zdish()
  serve main {
    plate perPerson on SoupBowl { x }
    plate perPerson on DeepPlate { y }
    plate perPerson on SoupBowl { z }
  }
}
kitchen today : Options {
  cooks: 1
}
