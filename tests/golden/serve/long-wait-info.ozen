// args: debug schedule --entry dinner --options today
action stewY(soupBowl: T) -> T<doneness: done> {
  uses hands for 40 min
}
recipe clearSoup {
  ingredients {
    dashi: 300 ml
  }
  let rested = rest(dashi, 10 min)
}
recipe porkStew {
  ingredients {
    pork: 300 g
  }
  let stewed = stewY(pork)
}
recipe hotWater {
  ingredients {
    water: 300 ml
  }
  let rested = rest(water, 13 min)
}
menu dinner {
  let soupBowl = make clearSoup
  let stewBowl = make porkStew
  let waterGlass = make hotWater
  serve main {
    plate perPerson on SoupBowl { soupBowl }
    plate perPerson on DeepPlate { stewBowl }
    plate perPerson on SoupBowl { waterGlass }
  }
}
kitchen today : Options {
  cooks: 1
}
