// args: debug schedule --entry dinner --options today
action stewB(x: T) -> T<doneness: done> {
  uses hands for 30 min
}
recipe stew {
  ingredients {
    pork: 300 g
  }
  let stewed = stewB(pork)
}
menu dinner {
  let stewBowl = make stew
  serve main {
    plate perPerson on DeepPlate { stewBowl }
  }
  serve dessert after main + 40 min {
    plate perPerson on Glass {
      assemble { buy Cornflakes 30 g, buy Strawberry 2 pcs }
    } @justBeforeServe
  }
}
kitchen today : Options {
  cooks: 1
}
