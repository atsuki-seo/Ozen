// args: debug schedule --entry dinner --kitchen home --options today
action simmerIt(x: T) -> T<doneness: done> {
  uses HeatSource<stovetop> for 10 min @unattended
}
action prepIt(x: T) -> T {
  uses hands for 12 min
}
action boilIt(x: T) -> T<doneness: done> {
  uses hands, HeatSource<stovetop> for 5 min
}
recipe curry {
  ingredients {
    pork: 300 g
  }
  let curryPot = simmerIt(pork)
}
recipe soup {
  ingredients {
    dashi: 300 ml
  }
  let prepped = prepIt(dashi)
  let boiled = boilIt(prepped)
}
menu dinner {
  let curryPot = make curry
  let soupPot = make soup
  serve main {
    plate perPerson on DeepPlate { curryPot } @keepWarm(on: Stove, max: 60 min)
    plate perPerson on SoupBowl { soupPot }
  }
}
kitchen home {
  places {
    stove: IHStove { burners: 2 }
  }
}
kitchen today : Options {
  cooks: 1
}
