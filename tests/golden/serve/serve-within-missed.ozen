// args: debug schedule --entry dinner --options today
action topIt(x: T) -> T {
  uses hands for 1 min
}
recipe dessert {
  ingredients {
    ice: VanillaIce 100 g
  }
  let topped = topIt(ice)
}
menu dinner {
  let topped = make dessert
  serve main {
    plate perPerson on Glass { topped } @serveWithin(30 s)
  }
}
kitchen today : Options {
  cooks: 1
}
