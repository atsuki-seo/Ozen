// args: debug schedule --entry dinner --options today
action stewB(x: T) -> T<doneness: done> {
  uses hands for 30 min
}
recipe stew {
  ingredients {
    pork: 300 g
  }
  let cooked = stewB(pork)
}
recipe soup {
  ingredients {
    dashi: 300 ml
  }
  let cooked = rest(dashi, 10 min)
}
menu dinner {
  let soupBowl = make soup
  let stewBowl = make stew
  serve main {
    plate perPerson on SoupBowl { soupBowl } @serveWithin(5 min)
    plate perPerson on DeepPlate { stewBowl }
  }
}
kitchen today : Options {
  cooks: 1
  serveAt: 60 min
}
