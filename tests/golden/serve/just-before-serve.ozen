// args: debug schedule --entry dinner --options today
action topIt(x: T) -> T {
  uses hands for 1 min
}
action stewB(x: T) -> T<doneness: done> {
  uses hands for 30 min
}
recipe stew {
  ingredients {
    pork: 300 g
  }
  let stewed = stewB(pork)
}
recipe dessert {
  ingredients {
    ice: VanillaIce 100 g
  }
  let rested = rest(ice, 10 min)
  let topped = topIt(rested)
}
menu dinner {
  let stewBowl = make stew
  let topped = make dessert
  serve main {
    plate perPerson on DeepPlate { stewBowl }
    plate perPerson on Glass { topped } @justBeforeServe
  }
}
kitchen today : Options {
  cooks: 2
}
