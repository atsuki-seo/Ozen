// args: debug schedule --entry dinner --kitchen home --options today
action tossIt(x: T) -> T {
  uses hands for 2 min
}
recipe salad {
  ingredients {
    lettuce: 100 g
  }
  let tossed = tossIt(lettuce)
}
recipe slaw {
  ingredients {
    cabbage: 100 g
  }
  let tossed = tossIt(cabbage)
}
action stewB(x: T) -> T<doneness: done> {
  uses hands for 30 min
}
recipe stew {
  ingredients {
    pork: 300 g
  }
  let stewed = stewB(pork)
}
menu dinner {
  let saladBowl = make salad
  let slawBowl = make slaw
  let stewBowl = make stew
  serve main {
    plate perPerson on SmallBowl { saladBowl } @chilled
    plate perPerson on SmallBowl { slawBowl } @chilled
    plate perPerson on DeepPlate { stewBowl }
  }
}
kitchen home {
  places {
    fridge: Fridge { capacity: 1 }
  }
}
kitchen today : Options {
  cooks: 1
}
