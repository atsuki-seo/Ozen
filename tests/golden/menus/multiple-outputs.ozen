// args: debug steps
action fillet3(x: T) -> (T<back>, T<collar>, T<frame>)
recipe filletBuri(fish: Buri) -> (Buri<back>, Buri<collar>, Buri<frame>) {
  let (back, collar, frame) = fillet3(fish)
}
menu dinner {
  let buri = buy Buri 3000 g
  let (back, collar, frame) = make filletBuri(fish: buri)
  let sliced = cut(back, style: slice)
  store(collar)
  discard(frame)
}
