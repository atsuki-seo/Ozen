// args: debug steps
recipe warmNaan -> Naan {
  ingredients { naan: 2 pcs }
  let warmed = warm(naan)
}
recipe naanPlate(bread: Naan) {
  let toasted = warm(bread)
}
menu madeAtHome {
  let naan = make warmNaan
  let plate = make naanPlate(bread: naan)
}
menu bought {
  let naan = buy Naan 2 pcs
  let plate = make naanPlate(bread: naan)
}
