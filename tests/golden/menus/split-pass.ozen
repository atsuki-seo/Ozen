// args: debug steps
recipe chashu -> Pork {
  ingredients { pork: 400 g }
  let cooked = simmer(pork, 60 min)
}
recipe ramen(topping: Pork<doneness: done>) {
  let cooked = cut(topping, style: slice)
}
recipe friedRice(topping: Pork<doneness: done>) {
  let cooked = cut(topping, style: dice)
}
menu lunch {
  let chashuBlock = make chashu
  let (ramenSlices, riceDice) = split(chashuBlock, 150 g)
  let ramenBowl = make ramen(topping: ramenSlices)
  let friedRicePlate = make friedRice(topping: riceDice)
  let again = make ramen(topping: chashuBlock)
}
