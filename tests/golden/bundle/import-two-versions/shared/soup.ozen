bundle {
  std: "0.1.0"
  entry: soup
  from: other "1.0.0"
  from: dashi "1.3.0"
}

module dashi.stock {
ingredient Katsuobushi : Seasoning
}

module other.soup {
import dashi.stock.{Katsuobushi}

recipe soup() {
  ingredients {
    water: 400 ml
    bonito: Katsuobushi 10 g
  }
  let s = simmer([water, bonito], 5 min)
}
}
