bundle {
  std: "0.1.0"
  entry: dinner
  from: book "1.0.0"
}

module book.menus.dinner {
import recipes.soup.{soup}

menu dinner(people: 2) {
  let simmered = make soup
  serve main {
    plate perPerson on SoupBowl { simmered }
  }
}
}

module book.recipes.soup {
recipe soup {
  ingredients {
    water: 400 ml
  }
  let simmered = simmer(water, 5 min)
}
}
