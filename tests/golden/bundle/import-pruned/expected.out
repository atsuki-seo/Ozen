bundle {
  std: "{{STD_VERSION}}"
  entry: soup
  from: book "1.0.0"
  from: dashi "1.2.5"
}

module book.soup {
import dashi.stock.{Katsuobushi}

recipe soup {
  ingredients {
    water: 400 ml
    bonito: Katsuobushi 10 g
  }
  let simmered = simmer([water, bonito], 5 min)
}
}

module dashi.stock {
ingredient Katsuobushi : Seasoning
}
exit 0
