bundle {
  std: "{{STD_VERSION}}"
  entry: naanPlate
  from: book "1.0.0"
}

module book.pantry.ovens {
// An oven warms naan too.
extend action warm {
  variant oven {
    uses HeatSource<oven> for 5..8 min
  }
}
}

module book.pantry.rules {
rule afterOily after Greasy: rinse
}

module book.r {
recipe naanPlate {
  ingredients { naan: 1 pcs }
  let warmed = warm(naan)
}
}
exit 0
