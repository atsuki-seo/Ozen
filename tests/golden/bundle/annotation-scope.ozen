bundle {
  std: "0.1.0"
  entry: dinner
  from: book "1.0.0"
}

module book.a {
recipe soupA {
  ingredients {
    water: 200 cc @allow(deprecated)
    rice: 300 g
  }
  let (sliced, diced) = split(rice, 100 g) @expect(leftoverPart)
  let boiled = wash(sliced)
  let simmered = simmer(water, 3 min)
}
}

module book.b {
recipe soupB {
  ingredients {
    water: 200 cc
  }
  let simmered = simmer(water, 3 min)
}
}

module book.menus {
import book.a.{soupA}
import book.b.{soupB}

menu dinner(people: 2) {
  let firstBowl = make soupA
  let secondBowl = make soupB
  serve main {
    plate perPerson on SoupBowl { firstBowl }
    plate perPerson on Bowl { secondBowl }
  }
}
}
