bundle {
  std: "0.1.0"
  entry: dinner
  from: book "1.0.0"
}

module book.a {
recipe soupA() {
  ingredients {
    water: 200 cc @allow(deprecated)
    rice: 300 g
  }
  let (p, q) = split(rice, 100 g) @expect(leftoverPart)
  let w = wash(p)
  let s = simmer(water, 3 min)
}
}

module book.b {
recipe soupB() {
  ingredients {
    water: 200 cc
  }
  let s = simmer(water, 3 min)
}
}

module book.menus {
import book.a.{soupA}
import book.b.{soupB}

menu dinner(people: 2) {
  let a = make soupA()
  let b = make soupB()
  serve main {
    plate perPerson on SoupBowl { a }
    plate perPerson on Bowl { b }
  }
}
}
