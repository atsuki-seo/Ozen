bundle {
  std: "{{STD_VERSION}}"
  entry: dinner
  from: kitchenBook "0.3.0"
  from: dashi "1.2.5"
  license: "CC-BY-4.0"
}

module dashi.stock {
ingredient Katsuobushi : Seasoning
}

module kitchenBook.menus.dinner {
import recipes.soup.{soup}

menu dinner(people: 2) {
  let s = make soup()
  serve main {
    plate perPerson on SoupBowl { s }
  }
}
}

module kitchenBook.recipes.soup {
import dashi.stock.{Katsuobushi}

// Clear soup with bonito flakes.
recipe soup() {
  ingredients {
    water: 400 ml
    bonito: Katsuobushi 10 g
  }
  let s = simmer([water, bonito], 5 min)
}
}

phrases en """
### kitchenBook
dish-dinner = Dinner
"""

phrases ja """
### dashi
ingredient-katsuobushi = かつお節
### kitchenBook
dish-dinner = 夕食
dish-soup = すまし汁
"""
exit 0
