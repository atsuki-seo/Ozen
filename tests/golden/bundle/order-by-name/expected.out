bundle {
  std: "{{STD_VERSION}}"
  entry: dinner
  from: book "1.0.0"
  from: zeta "2.0.0"
}

module book.recipes.soup {
import zeta.fish.{Niboshi}

recipe soup() {
  ingredients {
    water: 400 ml
    fish: Niboshi 10 g
  }
  let s = simmer([water, fish], 5 min)
}
}

module book.zmenus.dinner {
import recipes.soup.{soup}

menu dinner(people: 2) {
  let s = make soup()
  serve main {
    plate perPerson on SoupBowl { s }
  }
}
}

module zeta.fish {
ingredient Niboshi : Seasoning
}
exit 0
