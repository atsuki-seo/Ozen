schedule r level=2 cooks=1
  0..60 (60) %2 trim by cook1 [counter#1, board#1]
  60..180 (180) %3 sear by cook1 [stove#1, pan#1]
  180..300 (240) wash board#1 after rawMeat by cook1 [sink#1, board#1]
  300..360 (330) wipe counter#1 after use by cook1 [counter#1]
  360..480 (420) wipe stove#1 after use by cook1 [stove#1]
  480..660 (540) wash pan#1 after oil by cook1 [sink#1, pan#1]
  total 660
result ok errors=0 warnings=0 infos=0
exit 0
