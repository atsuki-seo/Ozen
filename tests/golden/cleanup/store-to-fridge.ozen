// args: debug schedule --kitchen home --options today
action steep(x: T) -> T {
  uses Washing for 10 min @unattended
}
kitchen home {
  places {
    fridge: Fridge
  }
}
recipe gohan {
  ingredients {
    rice: 300 g
  }
  let (portion, rest) = split(rice, 200 g)
  store(rest)
  let steeped = steep(portion)
}
kitchen today : Options {
  cleanup: afterMeal
}
