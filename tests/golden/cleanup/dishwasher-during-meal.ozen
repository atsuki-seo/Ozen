// args: debug schedule --entry dinner --kitchen home --options today
action trim(x: T) -> T {
  uses hands, WorkSurface, CuttingSurface for 1 min
  leaves: x on CuttingSurface
}
recipe salad {
  ingredients {
    lettuce: 100 g
  }
  let trimmed = trim(lettuce)
}
recipe sweet {
  ingredients {
    ice: VanillaIce 100 g
  }
  let rested = rest(ice, 5 min)
}
menu dinner {
  let saladPlate = make salad
  let sweetPlate = make sweet
  serve main {
    plate perPerson on FlatPlate { saladPlate }
  }
  serve sweets after main + 30 min {
    plate perPerson on Glass { sweetPlate }
  }
}
kitchen home {
  places {
    dw: Dishwasher
  }
  tools {
    board: CuttingBoard
  }
}
kitchen today : Options {
  cooks: 1
  cleanup: afterMeal
}
