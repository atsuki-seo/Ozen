recipe bibimbap @deny(leftoverPart) {
  ingredients {
    rice: 300 g
    beans: BeanSprouts 300 g
  }
  let (bowlRice, spareRice) = split(rice, 100 g) @allow(leftoverPart)
  let (bowlSprouts, spareSprouts) = split(beans, 100 g)
  let washedRice = wash(bowlRice)
  let washedSprouts = wash(bowlSprouts)
}
