// args: check --kitchen home
kitchen home {
  places {
    stove: IHStove
  }
  tools {
    pot: Pot { capacity: 2.4 L }
  }
}
action stew(x: T) -> T<doneness: done> {
  uses HeatSource<stovetop>, Container<capacity >= volume(x) * 1.2>
}
recipe smallStew {
  ingredients { water: 2 L }
  let stewed = stew(water)
}
recipe bigStew {
  ingredients { water: 2.1 L }
  let stewed = stew(water)
}
