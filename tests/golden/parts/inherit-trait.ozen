// args: debug steps
action roastLoin(roasted: T<loin>) -> T<doneness: done>
action braise(roasted: T<Fatty>) -> T<doneness: done>
recipe porkRoast {
  ingredients {
    roastCut: Pork<shoulderLoin> 300 g
    braiseCut: Pork<shoulderLoin> 200 g
  }
  let roasted = roastLoin(roastCut)
  let braised = braise(braiseCut)
}
