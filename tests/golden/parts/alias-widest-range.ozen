// args: debug steps
ingredient Boar : Meat, Hazard {
  axes: doneness, shape
  props {
    density: 1.00 g/ml
  }
  parts {
    lean {
      props {
        density: 1.05..1.10 g/ml
      }
    }
    fat {
      props {
        density: 0.90..0.95 g/ml
      }
    }
  }
}
alias BoarCut = Boar<lean | fat>
recipe botanNabe {
  ingredients {
    boar: BoarCut 100 ml
    salt: 2 g
  }
  let fried = fry([boar, salt], 5 min)
}
