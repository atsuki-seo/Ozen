// args: debug steps
ingredient Lean : Meat {
  axes: doneness
  props {
    density: 1.05..1.10 g/ml
  }
}
ingredient Fat : Meat, Hazard {
  axes: doneness
  props {
    density: 0.90..0.95 g/ml
  }
}
ingredient Aibiki : Mixture {
  axes: doneness
  contains: { Lean: 0..100 %, Fat: 0..100 % }
}
ingredient Aibiki37 : Mixture {
  axes: doneness
  contains: { Lean: 30..40 %, Fat: 60..70 % }
}
recipe hamburgSteak {
  ingredients {
    mince: Aibiki 100 ml
    leanMince: Aibiki37 100 ml
  }
  let fried = fry([mince, leanMince], 5 min)
}
