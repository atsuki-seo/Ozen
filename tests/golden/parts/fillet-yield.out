recipe simesaba
  saba : Saba 1000 g
  %1 = fillet3(saba) : (Saba<fillet> 500..600 g, Saba<head> 150..200 g, Saba<frame> 200..350 g)
  %2 = cut(%1.1, style: slice) : Saba<fillet, shape: cut(slice, 3 mm)> 500..600 g
  %3 = store(%1.2)
  %4 = discard(%1.3)
result ok errors=0 warnings=0 infos=0
exit 0
