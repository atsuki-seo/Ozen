// args: debug steps
ingredient Saba : Fish, Hazard, RawEdible, SkinEdible {
  axes: doneness, shape
  parts {
    fillet {
      props {
        yield: 50..60 %
      }
    }
    head {
      props {
        yield: 15..20 %
      }
    }
    frame
  }
}
action fillet3(x: T) -> (T<fillet>, T<head>, T<frame>)
recipe simesaba {
  ingredients { saba: 1000 g }
  let (body, head, bones) = fillet3(saba)
  let sliced = cut(body, style: slice)
  store(head)
  discard(bones)
}
