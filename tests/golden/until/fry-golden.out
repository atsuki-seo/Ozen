recipe friedOnion
  onion : Onion 1 pcs
  %1 = peel(onion) : Onion<shape: peeled> 1 pcs
  %2 = cut(%1, slice, 3 mm) : Onion<shape: cut(slice, 3 mm)> 1 pcs
  %3 = fry(%2, 300 s, until: browning >= golden) : Onion<doneness: done, browning: golden, shape: cut(slice, 3 mm)> 1 pcs
result ok errors=0 warnings=0 infos=0
exit 0
