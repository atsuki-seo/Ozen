recipe softEgg
  egg : Egg 1 pcs
  %1 = crack(egg) : Egg<shape: cracked> 1 pcs
  %2 = beat(%1) : Egg<shape: beaten> 1 pcs
  %3 = fry(%2, until: doneness >= par) : Egg<doneness: par, shape: beaten> 1 pcs
warning SAF005 lightlyCookedEgg pipe.ozen:4:16-4:67 args=["Egg"]: lightly cooked egg
result ok errors=0 warnings=1 infos=0
exit 0
