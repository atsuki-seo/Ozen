// args: debug schedule --kitchen home --options today
action mark(x: T) -> T {
  uses hands, CuttingSurface for 1 min
  leaves: x on CuttingSurface
}
action touch(x: T) -> T {
  uses hands, CuttingSurface for 1 min
}
kitchen home {
  tools {
    board: CuttingBoard
  }
}
recipe prepBoard {
  ingredients {
    tomato: 1 pcs
    c1: Cabbage 50 g
  }
  parallel {
    branch marked {
      let marked = mark(tomato)
      let touched = touch(c1)
    }
  }
}
kitchen today : Options {
  cooks: 1
}
