// args: debug schedule --kitchen home --options today
action mark(x: T) -> T {
  uses hands, CuttingSurface for 1 min
  leaves: x on CuttingSurface
}
action touch(x: T) -> T {
  uses hands, CuttingSurface for 1 min
}
action fill(x: T) -> T {
  uses Washing for 5 min @unattended
}
kitchen home {
  tools {
    board: CuttingBoard
  }
}
recipe prepBoard {
  ingredients {
    pork: 200 g
    c1: Cabbage 50 g
    sugar: 10 g
    c2: Cabbage 50 g
    water: 500 ml
  }
  parallel {
    branch markedPork {
      let markedPork = mark(pork)
      let touched = touch(c1)
      let markedSugar = mark(sugar)
      let touchedAgain = touch(c2)
    }
    branch touched {
      let filled = fill(water)
    }
  }
}
kitchen today : Options {
  cooks: 1
}
