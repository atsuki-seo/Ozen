// args: debug schedule --kitchen home --options today
action chop(x: T) -> T {
  uses hands, CuttingSurface for 2 min
  leaves: x on CuttingSurface
}
action sear(x: T) -> T {
  uses hands, FryingPan for 3 min
  leaves: oil on FryingPan
}
action warmUp(x: T) -> T {
  uses hands, FryingPan for 1 min
}
kitchen home {
  tools {
    board: CuttingBoard
    pan: FryingPan
  }
}
recipe porkAndCabbage {
  ingredients {
    pork: 200 g
    cabbage: 100 g
  }
  let chopped = chop(pork)
  let seared = sear(chopped)
  let choppedCabbage = chop(cabbage)
  let warmed = warmUp(choppedCabbage)
}
kitchen today : Options {
  cooks: 1
}
