// args: debug schedule --entry lunch --kitchen home --options today
ingredient Egg : Allergen(egg) {
  leaves: allergen
}
recipe eggSalad {
  ingredients {
    egg: 2 pcs
  }
  let mixed = mix(egg)
}
recipe greenSalad {
  ingredients {
    lettuce: 100 g
  }
  let tossed = toss(lettuce)
}
menu lunch(people: 2) {
  let salad = choose perPerson from { make eggSalad, make greenSalad }
}
kitchen home {
  tools {
    bowl: MixingBowl
  }
}
kitchen today : Options {
  people: [Person { picks: [EggSalad] }, Person { picks: [GreenSalad], allergies: [egg] }]
}
