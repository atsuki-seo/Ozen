// args: check --format json --emit schedule --kitchen home --options today
action mark(x: T) -> T {
  uses hands, CuttingSurface for 1 min
  leaves: x on CuttingSurface
}
action touch(x: T) -> T {
  uses hands, CuttingSurface for 1 min
}
kitchen home {
  tools {
    board: CuttingBoard
  }
}
recipe prepBoard {
  ingredients {
    onion: 1 pcs
    pork: 200 g
    c1: Cabbage 50 g
  }
  parallel {
    branch markedFirst {
      let markedFirst = mark(onion)
      let markedSecond = mark(pork)
      let touched = touch(c1)
    }
  }
}
kitchen today : Options {
  cooks: 1
}
