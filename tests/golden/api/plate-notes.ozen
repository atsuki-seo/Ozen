// args: check --format json --emit ir --entry dinner
recipe soup() {
  ingredients {
    water: 300 ml
  }
  let w = boilWater(water)
}
recipe salad() {
  ingredients {
    lettuce: 100 g
  }
  let t = tear(lettuce)
}
menu dinner() {
  let a = make soup()
  let b = make salad()
  serve main {
    plate perPerson on SoupBowl { a } @whileWarm
    plate perPerson on SmallBowl { b } @chilled @serveWithin(30 min)
  }
}
