// args: check --format json --emit ir --entry dinner
recipe soup {
  ingredients {
    water: 300 ml
  }
  let boiled = boilWater(water)
}
recipe salad {
  ingredients {
    lettuce: 100 g
  }
  let torn = tear(lettuce)
}
menu dinner {
  let soupBowl = make soup
  let saladPlate = make salad
  serve main {
    plate perPerson on SoupBowl { soupBowl } @whileWarm
    plate perPerson on SmallBowl { saladPlate } @chilled @serveWithin(30 min)
  }
}
