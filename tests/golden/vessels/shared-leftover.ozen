// args: check
action stewB(x: T) -> T<doneness: done> {
  uses hands for 30 min
}
recipe stew {
  ingredients {
    pork: 300 g
  }
  let stewed = stewB(pork)
}
menu dinner(people: 4) {
  let stewPot = make stew
  let (served, leftover) = split(stewPot, 200 g)
  serve main {
    plate shared on Platter { served }
  }
}
