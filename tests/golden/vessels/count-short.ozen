// args: check --kitchen home
action stewB(x: T) -> T<doneness: done> {
  uses hands for 30 min
}
recipe stew {
  ingredients {
    pork: 300 g
  }
  let stewed = stewB(pork)
}
menu dinner(people: 4) {
  let stewBowl = make stew
  serve main {
    plate perPerson on Donburi { stewBowl }
  }
}
kitchen home {
  tableware {
    don: Donburi { count: 3 }
  }
}
