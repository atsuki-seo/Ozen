// args: check --entry dinner
recipe soup {
  ingredients { water: 300 ml }
  let boiled = boilWater(water)
}
menu dinner(people: 2) {
  let firstSoup = make soup
  let secondSoup = make soup
  let thirdSoup = make soup
  serve main {
    plate perPerson on deepPlate { firstSoup }
    plate perPerson on flatPlate { secondSoup }
    plate perPerson on smallBowl { thirdSoup }
  }
}
