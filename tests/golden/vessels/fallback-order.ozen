// args: check --kitchen home
action stewB(x: T) -> T<doneness: done> {
  uses hands for 30 min
}
recipe stew {
  ingredients {
    pork: 300 g
  }
  let stewed = stewB(pork)
}
menu dinner(people: 3) {
  let stewBowl = make stew
  serve main {
    plate perPerson on DeepPlate or Donburi { stewBowl }
  }
}
kitchen home {
  tableware {
    deep: DeepPlate { count: 2 }
    don: Donburi { count: 4 }
  }
}
