// args: debug ast --no-spans
menu katsuCurryNight(people: 4) {
  let rice = make cookedRice(servings: 4)
  let (fillet, kama) = filletBuri(buy Buri 1 pcs)
  let side = choose perPerson from { make cookedRice, buy Naan }
  serve main {
    plate perPerson on DeepPlate { rice, kama } @serveWithin(5 min)
  }
  serve dessert after main + 40 min {
    plate perPerson on Glass {
      assemble { flakes, buy VanillaIce @frozen, cream }
    } @justBeforeServe
  }
}
