recipe fragrantOnion
  onion : Onion 1 pcs
  %1 = peel(onion) : Onion<shape: peeled> 1 pcs
  %2 = cut(%1, mince, 2 mm) : Onion<shape: cut(mince, 2 mm)> 1 pcs
  %3 = fry(%2, 60 s, until: fragrant) : Onion<doneness: done, browning: light, shape: cut(mince, 2 mm)> 1 pcs
result ok errors=0 warnings=0 infos=0
exit 0
