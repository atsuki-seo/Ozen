ir dinner
  %1 = in rice : Rice 300 g
  %2 = op wash %1 : Rice -> Rice<prep has washed> 300 g [hands, Washing; 60..180 s]
  %3 = op soak %2 time=1800 s : Rice<prep has washed> -> Rice<prep has washed, prep has soaked(1800 s)> 300 g [Container; 1800 s; unattended]
  %4 = choose cookRice %3 : Rice<prep has washed, prep has soaked(1800 s)> -> CookedRice 300 g { cooker [RiceCooking; 2520..3240 s; unattended] | pot [hands, HeatSource<stovetop>, Pot; 1500..2100 s] | microwave [HeatSource<microwave>, Container; 900..1200 s; unattended] }
  %5 = in chicken : Chicken 300 g
