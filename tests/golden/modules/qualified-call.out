ir soup
  %1 = in onion : Onion 1 pcs
  %2 = op peel %1 : Onion -> Onion<shape: peeled> 1 pcs [hands, WorkSurface; 60..120 s]
  %3 = op cut %2 style=slice size=3 mm : Onion<shape: peeled> -> Onion<shape: cut(slice, 3 mm)> 1 pcs [hands, WorkSurface, CuttingSurface, Knife; 60..180 s]
  %4 = in carrot : Carrot 1 pcs
  %5 = op cut %4 style=rollCut size=20 mm : Carrot -> Carrot<shape: cut(rollCut, 20 mm)> 1 pcs [hands, WorkSurface, CuttingSurface, Knife; 60..180 s]
  %6 = op combine %3, %5 : Onion<shape: cut(slice, 3 mm)>, Carrot<shape: cut(rollCut, 20 mm)> -> Mixture 300..450 g [0 s]
  %7 = op simmer %6 time=600 s heat=low : Mixture -> Mixture<doneness: done> 300..450 g [HeatSource<stovetop>, Pot; 600 s; unattended]
result ok errors=0 warnings=0 infos=0
exit 0
