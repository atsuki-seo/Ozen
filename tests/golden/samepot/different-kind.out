schedule porkSoup level=2 cooks=1
  0..180 (60) preheat pan#1 to medium unattended [pan#1, stove#1]
  180..360 (360) %2 fry by cook1 [stove#1, pan#1]
  360..360 (360) %4 combine unattended
  360..660 (660) %5 simmer unattended [stove#1, pot#1]
  total 660
result ok errors=0 warnings=0 infos=0
exit 0
