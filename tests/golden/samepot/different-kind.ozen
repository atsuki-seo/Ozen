// args: debug schedule --kitchen home --options today
kitchen home {
  places {
    stove: IHStove { burners: 2 }
  }
  tools {
    pot: Pot { count: 3 }
    bowl: MixingBowl { count: 2 }
    pan: FryingPan { count: 2 }
  }
}
kitchen today : Options {
  cooks: 1
}
recipe porkSoup {
  ingredients {
    pork: 200 g
    water: 300 ml
  }
  let fried = pork |> fry(3 min)
  let soup = simmer([fried, water], 5 min)
}
