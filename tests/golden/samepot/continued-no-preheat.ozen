// args: debug schedule --kitchen home --options today
kitchen home {
  places {
    stove: IHStove { burners: 2 }
  }
  tools {
    pot: Pot
    pan: FryingPan { count: 2 }
  }
}
kitchen today : Options {
  cooks: 1
}
recipe friedPork {
  ingredients { pork: 200 g }
  let fried = pork |> fry(3 min) |> fry(2 min, heat: high)
}
