// args: debug schedule --kitchen home --options today
kitchen home {
  places {
    stove: IHStove
  }
  tools {
    pot: Pot
  }
}
recipe friedPotato {
  ingredients {
    potato: 2 pcs
    oil: 500 ml
  }
  let first = deepFry(potato / 2, oil / 2, 3 min)
  let second = deepFry(potato / 2, oil / 2, 3 min)
}
kitchen today : Options {
  cooks: 1
}
