diag-bad-escape = { $arg1 } is not a valid escape
diag-number-too-large = The number is too large
diag-reserved-word = { $arg1 } is a reserved word and cannot be a name
diag-input-too-large = The input is too large ({ $arg1 } bytes, limit { $arg2 })
diag-nesting-too-deep = The nesting is too deep (limit { $arg1 })
