diag-unknown-module = The module { $arg1 } was not found
diag-kitchen-reference = Recipes and menus cannot refer to the kitchen { $arg1 } by name
diag-ambiguous-entry = There are several entries ({ $arg1 }, { $arg2 }); choose one with --entry
