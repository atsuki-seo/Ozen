diag-import-cycle = The imports form a cycle ({ $arg1 } → { $arg2 } → { $arg3 })
diag-recipe-imports-menu = The recipe module { $arg1 } cannot import the menu module { $arg2 }
diag-top-folder-clash = The folder { $arg1 } clashes with a dependency's package name
